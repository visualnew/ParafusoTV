<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1D2024" android:centerColor="#15181B" android:endColor="#0E1012" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#50555B" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#20FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
