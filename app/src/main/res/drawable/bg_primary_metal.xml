<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_graphite_disabled_fill" />
            <stroke android:width="1dp" android:color="@color/button_graphite_disabled_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_graphite_pressed_fill" />
            <stroke android:width="3dp" android:color="@color/button_graphite_focus_ring" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_graphite_focused_fill" />
            <stroke android:width="3dp" android:color="@color/button_graphite_focus_ring" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_graphite_pressed_fill" />
            <stroke android:width="1dp" android:color="@color/button_graphite_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_graphite_fill" />
            <stroke android:width="1dp" android:color="@color/button_graphite_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
