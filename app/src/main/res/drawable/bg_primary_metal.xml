<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="#FFF4F5F6" android:centerColor="#FFC7CBD1" android:endColor="#FF8E959F" />
            <stroke android:width="3dp" android:color="@color/focus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="#FFDDE0E3" android:endColor="#FF8E959F" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="#FFE5E7EA" android:endColor="#FF7D858F" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
